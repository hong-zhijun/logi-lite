  "localized_resources": [
    {
      "path": "/Library/Application Support/Logitech.localized/LogiOptionsPlus/logioptionsplus_agent.app/Contents/Resources/data/strings/en-US.yaml",
      "sha256": "a480af434d8c43d04d97586aec7c835d5fdca5e583a2299384efc1f95b008eb2",
      "first_line": 1942,
      "last_line": 1957,
      "excerpt": "CONFIGURATION_HORIZONTAL_SCROLL: Horizontal scrolling\nCONFIGURATION_TITLE_FORWARD_BUTTON: Forward button\nCONFIGURATION_TITLE_BACK_BUTTON: Back button\nCONFIGURATION_HORIZONTAL_SCROLL_ENABLED: On\nCONFIGURATION_HORIZONTAL_SCROLL_DISABLED: Off\nCONFIGURATION_COPY_HORIZONTAL_SCROLLING: Hold the button and use the scroll wheel to scroll horizontally.\nHORIZONTAL_SCROLL_DISABLING_TOOLTIP: This will disable horizontal scrolling\nHORIZONTAL_SCROLL_OTHER_ACTION_ASSIGNMENT_CONFLICT_TITLE: Horizontal scrolling has been disabled on this button.\nHORIZONTAL_SCROLL_DEFAULT_APP_ASSIGNMENT_CONFLICT_DESCRIPTION: You cannot scroll horizontally with this button with {CONFLICT_ACTION} assigned to it.\nHORIZONTAL_SCROLL_OTHER_APP_ASSIGNMENT_CONFLICT_DESCRIPTION: You cannot scroll horizontally with this button in {APP_NAME} with {CONFLICT_ACTION} assigned to it.\nHORIZONTAL_SCROLL_OTHER_ACTION_ASSIGNMENT_CONFLICT_AGREE_BUTTON: OK GOT IT\nHORIZONTAL_SCROLL_ASSIGNMENT_CONFLICT_TITLE: This will reset the button to it's default action\nHORIZONTAL_SCROLL_ASSIGNMENT_CONFLICT_DESCRIPTION: You cannot perform {CONFLICT_ACTION} with this button if you enable horizontal scrolling. The button will be reset to it's default action.\nHORIZONTAL_SCROLL_ASSIGNMENT_CONTINUE: CONTINUE\nHORIZONTAL_SCROLL_ASSIGNMENT_CANCEL: CANCEL\nHORIZONTAL_SCROLL_DISABLED: Horizontal scrolling is disabled while {CONFLICT_ACTION} is assigned to the button."
    },
    {
      "path": "/Library/Application Support/Logitech.localized/LogiOptionsPlus/logioptionsplus_agent.app/Contents/Resources/data/strings/zh-CN.yaml",
      "sha256": "50d3d5a1e0079c99c3a4692e6db678bb5d0bfd473ae20a0db512616acd0c046c",
      "first_line": 1942,
      "last_line": 1957,
      "excerpt": "CONFIGURATION_HORIZONTAL_SCROLL: 水平滚动\nCONFIGURATION_TITLE_FORWARD_BUTTON: 前进按钮\nCONFIGURATION_TITLE_BACK_BUTTON: 后退按钮\nCONFIGURATION_HORIZONTAL_SCROLL_ENABLED: 开启\nCONFIGURATION_HORIZONTAL_SCROLL_DISABLED: 关闭\nCONFIGURATION_COPY_HORIZONTAL_SCROLLING: 按住按钮并使用滚轮水平滚动。\nHORIZONTAL_SCROLL_DISABLING_TOOLTIP: 这样将禁用水平滚动\nHORIZONTAL_SCROLL_OTHER_ACTION_ASSIGNMENT_CONFLICT_TITLE: 此按钮已禁用水平滚动。\nHORIZONTAL_SCROLL_DEFAULT_APP_ASSIGNMENT_CONFLICT_DESCRIPTION: \"您无法使用已分配 {CONFLICT_ACTION} 的此按钮进行水平滚动。\"\nHORIZONTAL_SCROLL_OTHER_APP_ASSIGNMENT_CONFLICT_DESCRIPTION: \"您无法在 {APP_NAME} 中使用已分配 {CONFLICT_ACTION} 的此按钮进行水平滚动。\"\nHORIZONTAL_SCROLL_OTHER_ACTION_ASSIGNMENT_CONFLICT_AGREE_BUTTON: 明白\nHORIZONTAL_SCROLL_ASSIGNMENT_CONFLICT_TITLE: 这会将按钮重置为其默认操作\nHORIZONTAL_SCROLL_ASSIGNMENT_CONFLICT_DESCRIPTION: \"如果启用水平滚动，你将无法使用此按钮执行 {CONFLICT_ACTION}。此按钮将重置为其默认操作。\"\nHORIZONTAL_SCROLL_ASSIGNMENT_CONTINUE: 继续\nHORIZONTAL_SCROLL_ASSIGNMENT_CANCEL: 取消\nHORIZONTAL_SCROLL_DISABLED: \"当 {CONFLICT_ACTION}分配给按钮时，水平滚动将被禁用。\""
    }
  ]
}
