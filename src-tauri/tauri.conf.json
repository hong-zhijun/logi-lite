{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Logi Lite",
  "version": "0.2.0",
  "identifier": "io.github.hong-zhijun.logi-lite",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Logi Lite",
        "width": 1080,
        "height": 800,
        "minWidth": 920,
        "minHeight": 800,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "backgroundColor": "#F5F5F7",
        "center": true,
        "maxHeight": 800
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self'; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/icon.png"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "infoPlist": "Info.plist"
    }
  }
}
